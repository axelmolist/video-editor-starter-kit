# Copy to .env (gitignored) and fill in. /setup does this with you. Never commit .env.

# Required: ElevenLabs Scribe transcription (elevenlabs.io -> Settings -> API keys)
ELEVENLABS_API_KEY=

# Optional: Higgsfield, if you use its API directly rather than its MCP server
HIGGSFIELD_API_KEY=

# Optional: S3-compatible storage for public video URLs (DigitalOcean Spaces, AWS S3, Cloudflare R2)
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=
SPACES_ENDPOINT=

# Optional: path to Chrome for Chrome-typeset hook cards (defaults to the macOS location)
CHROME=
